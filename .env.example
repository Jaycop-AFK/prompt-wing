# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงของโปรเจกต์ (.env ไม่ถูกเก็บใน git เพราะมี key จริง)

# Supabase > Settings > API > Project URL
EXPO_PUBLIC_SUPABASE_URL=

# Supabase > Settings > API > Project API keys > anon / publishable
# key นี้ปลอดภัยที่จะฝังในแอปฝั่งไคลเอนต์ เพราะ Row Level Security ที่ตั้งไว้ในตาราง
# (supabase/schema.sql) เป็นตัวป้องกันจริง ไม่ใช่ key นี้
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ใช้เฉพาะตอนสาธิตเมื่อ Supabase สำหรับพัฒนายังไม่พร้อม ค่า EXPO_PUBLIC_* มองเห็นได้ใน bundle
# จึงห้ามใช้บัญชีจริงหรือรหัสผ่านที่ใช้กับระบบอื่น
EXPO_PUBLIC_AUTH_MODE=
EXPO_PUBLIC_DEMO_EMAIL=
EXPO_PUBLIC_DEMO_PASSWORD=

# GraphHopper > Dashboard > API keys (สมัครฟรีไม่ต้องผูกบัตรเครดิต) ใช้สร้างเส้นทางวงกลมวิ่งตามถนนจริง
EXPO_PUBLIC_GRAPHHOPPER_API_KEY=
