{
  "name": "prompt-wing",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "remote": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-remote.ps1",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "android:dev": "expo run:android",
    "ios:dev": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "go": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-go.ps1",
    "go:tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-remote.ps1"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans-thai": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@kingstinct/react-native-healthkit": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "@supabase/supabase-js": "^2.112.4",
    "expo": "~57.0.23",
    "expo-build-properties": "~57.0.20",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.18",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.18",
    "expo-notifications": "~57.0.19",
    "expo-router": "~57.0.21",
    "expo-sensors": "~57.0.3",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.25",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-health-connect": "^4.1.3",
    "react-native-maps": "1.27.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "standard-navigation": "^0.0.5"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.14",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "private": true,
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
