{
  "expo": {
    "name": "พร้อมวิ่ง",
    "slug": "human13254",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "promptwing",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sutti.promptwing"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E7F5E9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sutti.promptwing",
      "permissions": [
        "android.permission.HIGH_SAMPLING_RATE_SENSORS",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.health.READ_LEAN_BODY_MASS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.HIGH_SAMPLING_RATE_SENSORS",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.health.READ_LEAN_BODY_MASS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "พร้อมวิ่งใช้ตำแหน่งของคุณเพื่อบอกสภาพอากาศและฝุ่นตรงที่คุณอยู่ หาที่วิ่งใกล้ตัว และวาดเส้นทางระหว่างวิ่งจริง",
          "locationWhenInUsePermission": "พร้อมวิ่งใช้ตำแหน่งของคุณเพื่อบอกสภาพอากาศและฝุ่นตรงที่คุณอยู่ หาที่วิ่งใกล้ตัว และวาดเส้นทางระหว่างวิ่งจริง",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "พร้อมวิ่งขอเข้าถึงรูปภาพที่คุณเลือก เพื่อแนบกับโพสต์หาเพื่อนวิ่ง",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "พร้อมวิ่งอ่านน้ำหนัก เปอร์เซ็นต์ไขมัน และมวลไร้ไขมันจาก Apple Health เมื่อคุณกดอนุญาต เพื่ออัปเดตโปรไฟล์สุขภาพของคุณ",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "react-native-health-connect",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8fc6dd33-8961-499b-b7e2-7597ab0de425"
      }
    },
    "owner": "promptwing",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8fc6dd33-8961-499b-b7e2-7597ab0de425"
    }
  }
}
